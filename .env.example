# Tuition Website Configuration
# ==============================

# Resend API Key for sending admission enquiry notification emails
# (Optional for local development; if omitted, enquiries are safely logged in mock mode)
RESEND_API_KEY=re_your_resend_api_key_here

# Recipient email where new student enquiries should be delivered
NOTIFICATION_EMAIL=admissions@example.com

# Verified sender email address in Resend (e.g., enquiries@yourdomain.com)
FROM_EMAIL=onboarding@resend.dev
